events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;

    # Resolver for dynamic DNS resolution (Docker's internal DNS)
    resolver 127.0.0.11 valid=10s;

    # Upstream for API - using variable for runtime DNS resolution
    # Note: upstream blocks don't support variables, so we'll use proxy_pass with variable directly

    server {
        listen 80;
        server_name localhost;
        root /usr/share/nginx/html;
        index index.html;
        absolute_redirect off;

        # Additional headers for security and CORS
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options SAMEORIGIN;
        add_header X-XSS-Protection "1; mode=block";
        add_header Access-Control-Allow-Origin *;

        # API proxy
        # Using direct variable substitution for runtime DNS resolution
        location /mentor/api/ {
            proxy_pass http://${API_HOST}:${API_PORT}/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        location /api/ {
            proxy_pass http://${API_HOST}:${API_PORT}/api/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # Health check
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        location = / {
            return 302 /mentor/;
        }

        # Runtime IdP URL — generated at container start; must not be immutable-cached
        location = /mentor/runtime-config.js {
            add_header Cache-Control "no-store";
            try_files /runtime-config.js =404;
        }

        location = /runtime-config.js {
            add_header Cache-Control "no-store";
            try_files $uri =404;
        }

        # Map the public journey prefix to the Vite dist root and handle Vue Router history mode.
        # HTML must not be cached: a stale shell with root /assets URLs 404s on welcome :8080.
        location /mentor/ {
            rewrite ^/mentor/(.*)$ /$1 break;
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-store";
        }

        # Keep root-path files available for direct-port debugging
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-store";
        }

        # Map and cache prefixed static assets from the dist root
        location ~* ^/mentor/(.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$ {
            rewrite ^/mentor/(.*)$ /$1 break;
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Cache root-path static assets used for direct-port debugging
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
}
